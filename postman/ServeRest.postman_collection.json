{
  "info": {
    "name": "ServeRest - API Tests",
    "description": "Fluxo E2E de API: usuário → login → produto → carrinho → limpeza. Cada request valida status code, mensagens e dados retornados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Usuários",
      "item": [
        {
          "name": "Cadastrar usuário administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// E-mail único a cada execução",
                  "pm.collectionVariables.set(\"email\", `postman_${Date.now()}@qa.com`);",
                  "pm.collectionVariables.set(\"nomeProduto\", `Produto Postman ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mensagem de sucesso\", () => pm.expect(pm.response.json().message).to.eql(\"Cadastro realizado com sucesso\"));",
                  "pm.test(\"_id com 16 caracteres\", () => pm.expect(pm.response.json()._id).to.match(/^[A-Za-z0-9]{16}$/));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"QA Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"senha123\",\n  \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cadastrar usuário com e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensagem de e-mail em uso\", () => pm.expect(pm.response.json().message).to.eql(\"Este email já está sendo usado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"QA Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"senha123\",\n  \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar usuário por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna o usuário cadastrado\", () => {",
                  "    const u = pm.response.json();",
                  "    pm.expect(u._id).to.eql(pm.collectionVariables.get(\"userId\"));",
                  "    pm.expect(u.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(u.administrador).to.eql(\"true\");",
                  "});",
                  "pm.test(\"Contrato do usuário\", () => {",
                  "    const schema = {",
                  "        type: \"object\",",
                  "        required: [\"nome\", \"email\", \"password\", \"administrador\", \"_id\"],",
                  "        properties: {",
                  "            nome: { type: \"string\" }, email: { type: \"string\" }, password: { type: \"string\" },",
                  "            administrador: { type: \"string\", enum: [\"true\", \"false\"] }, _id: { type: \"string\" }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login com credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Token Bearer retornado\", () => pm.expect(pm.response.json().authorization).to.match(/^Bearer .+/));",
                  "pm.test(\"Tempo de resposta < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().authorization);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login com senha incorreta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensagem de credenciais inválidas\", () => pm.expect(pm.response.json().message).to.eql(\"Email e/ou senha inválidos\"));",
                  "pm.test(\"Não retorna token\", () => pm.expect(pm.response.json()).to.not.have.property(\"authorization\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"senhaErrada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Produtos",
      "item": [
        {
          "name": "Cadastrar produto sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensagem de token ausente\", () => pm.expect(pm.response.json().message).to.include(\"Token de acesso ausente\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeProduto}}\",\n  \"preco\": 150,\n  \"descricao\": \"Produto criado pelo Postman\",\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          }
        },
        {
          "name": "Cadastrar produto com administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mensagem de sucesso\", () => pm.expect(pm.response.json().message).to.eql(\"Cadastro realizado com sucesso\"));",
                  "pm.collectionVariables.set(\"productId\", pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeProduto}}\",\n  \"preco\": 150,\n  \"descricao\": \"Produto criado pelo Postman\",\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar produto por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Dados do produto persistidos\", () => {",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.nome).to.eql(pm.collectionVariables.get(\"nomeProduto\"));",
                  "    pm.expect(p.preco).to.eql(150);",
                  "    pm.expect(p.quantidade).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Cadastrar produto com preço 0 (valor-limite inválido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensagem de preço inválido\", () => pm.expect(pm.response.json().preco).to.eql(\"preco deve ser um número positivo\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto preço zero {{$timestamp}}\",\n  \"preco\": 0,\n  \"descricao\": \"BVA\",\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Carrinhos",
      "item": [
        {
          "name": "Criar carrinho",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mensagem de sucesso\", () => pm.expect(pm.response.json().message).to.eql(\"Cadastro realizado com sucesso\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carrinhos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrinhos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtos\": [\n    {\n      \"idProduto\": \"{{productId}}\",\n      \"quantidade\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Estoque baixado após carrinho",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Quantidade passou de 5 para 3\", () => pm.expect(pm.response.json().quantidade).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Cancelar compra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estoque reabastecido\", () => pm.expect(pm.response.json().message).to.include(\"Estoque dos produtos reabastecido\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carrinhos/cancelar-compra",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrinhos",
                "cancelar-compra"
              ]
            }
          }
        },
        {
          "name": "Estoque devolvido após cancelamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Quantidade voltou para 5\", () => pm.expect(pm.response.json().quantidade).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Limpeza",
      "item": [
        {
          "name": "Excluir produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Produto excluído\", () => pm.expect(pm.response.json().message).to.eql(\"Registro excluído com sucesso\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Excluir usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Usuário excluído\", () => pm.expect(pm.response.json().message).to.eql(\"Registro excluído com sucesso\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{userId}}"
              ]
            }
          }
